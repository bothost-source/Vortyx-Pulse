{
  "name": "vortyx-pulse-backend",
  "version": "1.0.0",
  "description": "Backend API for Vortyx Pulse — auth, API keys, payments, admin console, and the public AI API proxy.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate": "node -e \"require('fs').readFile('./db/schema.sql','utf8',(e,sql)=>{if(e)throw e; require('./db/pool').query(sql).then(()=>{console.log('Schema applied');process.exit(0);}).catch(err=>{console.error(err);process.exit(1);});})\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.11.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}
