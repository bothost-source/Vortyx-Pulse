

# Render Postgres connection string (Render gives you this automatically
# when you create a Postgres database — under "Connections" > "Internal/External URL")
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Any long random string — used to sign login sessions (JWT)
JWT_SECRET=change-Vortyx-Pulse-jwt

# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application type). Add your deployed frontend URL under
# "Authorized JavaScript origins", e.g. https://vortyxpulse.onrender.com
GOOGLE_CLIENT_ID=253715273543-ettj51bujhigopbkkre4fcj8lsqo03v1.apps.googleusercontent.com

# Stripe (card payments) — only needed once you wire up real Stripe in routes/payments.js
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Your own model endpoint, once ready — used inside routes/v1.js callModel()
MODEL_ENDPOINT=
MODEL_API_KEY=

NODE_ENV=production
PORT=3000
